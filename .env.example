# Optional Supabase account sync. These are the only Supabase values exposed to
# browser code. Configure OAuth secrets in Supabase, never in this file.
LR_SUPABASE_URL=
LR_SUPABASE_ANON_KEY=
LR_ALERTS_ENABLED=false

# GitHub Actions deal refresh controls
MAX_PRICE=70
PAGE_SIZE=60
PAGES_PER_STORE=3
MAX_NEW_STEAM_LOOKUPS=60

# Optional umbrella recommendation catalog
MAX_GAMES=5000
MAX_PAGES=8
